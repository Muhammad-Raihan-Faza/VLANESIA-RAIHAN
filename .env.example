# Salin file ini menjadi .env (hanya untuk tes di laptop), lalu isi dari Dashboard Supabase.
# Project Settings > Data API (URL)  dan  Project Settings > API Keys (Secret key).

# URL project, contoh: https://abcdefghijklmnop.supabase.co
# (jika terlanjur menempel ".../rest/v1/" atau spasi/kutip, kode akan merapikannya otomatis)
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Gunakan SECRET key (sb_secret_...) atau service_role key lama (eyJ...).
# JANGAN pakai Publishable/anon key. JANGAN taruh key ini di public/app.js atau diunggah ke GitHub.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxx

PORT=3000
